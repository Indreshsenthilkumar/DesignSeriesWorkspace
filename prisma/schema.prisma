generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String             @id @default(cuid())
  name                 String
  rollNo               String             @unique
  email                String             @unique
  department           String             @default("")
  year                 String             @default("")
  mobile               String             @default("")
  domain               String             @default("Data not Feeded")
  mentorName           String             @default("")
  linkedin             String             @default("")
  github               String             @default("")
  role                 String             @default("STUDENT")
  systemStatus         String             @default("ACTIVE")
  passwordHash         String
  mustChangePassword   Boolean            @default(true)
  lastLoginAt          DateTime?
  permUserManagement   Boolean            @default(false)
  permScanStudentQr    Boolean            @default(false)
  permMentorTasks      Boolean            @default(false)
  permLinkedinTracker  Boolean            @default(false)
  permWorklogs         Boolean            @default(false)
  permNotifications    Boolean            @default(false)
  permAttendanceLogs   Boolean            @default(false)
  permExtensionRequest Boolean            @default(false)
  permAdminDatabase    Boolean            @default(false)
  permActivityApproval Boolean            @default(false)
  rewardPoints         Int                @default(0)
  avatarSeed           Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  reviewedPasses       ActivityPass[]     @relation("PassReviewer")
  passes               ActivityPass[]     @relation("PassOwner")
  attendance           Attendance[]
  auditLogs            AuditLog[]
  reviewedExtensions   ExtensionRequest[] @relation("ExtensionReviewer")
  extensions           ExtensionRequest[] @relation("ExtensionOwner")
  linkedinPosts        LinkedinPost[]
  notes                Note[]
  notifications        Notification[]     @relation("NotificationAuthor")
  notificationReads    NotificationRead[]
  rewardEntries        RewardEntry[]
  tasksAssigned        Task[]             @relation("TaskAssignee")
  tasksCreated         Task[]             @relation("TaskAuthor")
  worklogs             Worklog[]

  @@index([role])
  @@index([year])
  @@index([domain])
  @@index([mentorName])
}

model Attendance {
  id        String   @id @default(cuid())
  userId    String
  date      String
  hour      Int
  reason    String   @default("")
  status    String   @default("PRESENT")
  source    String   @default("SELF")
  markedBy  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, hour])
  @@index([date])
  @@index([userId, date])
}

model Worklog {
  id           String    @id @default(cuid())
  userId       String
  date         String
  s1           String    @default("")
  s2           String    @default("")
  s3           String    @default("")
  s4           String    @default("")
  s5           String    @default("")
  taskId       String?
  status       String    @default("SUBMITTED")
  mentorRemark String    @default("")
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  task         Task?     @relation(fields: [taskId], references: [id])
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([status])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  authorId    String
  assigneeId  String?
  domain      String    @default("")
  year        String    @default("")
  priority    String    @default("MEDIUM")
  status      String    @default("TODO")
  dueDate     String?
  points      Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  author      User      @relation("TaskAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  worklogs    Worklog[]

  @@index([assigneeId, status])
  @@index([status])
}

model ActivityPass {
  id          String    @id @default(cuid())
  userId      String
  date        String
  fromTime    String
  toTime      String
  destination String
  reason      String
  category    String    @default("ACTIVITY")
  status      String    @default("PENDING")
  passCode    String    @unique
  remark      String    @default("")
  reviewerId  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  reviewer    User?     @relation("PassReviewer", fields: [reviewerId], references: [id])
  user        User      @relation("PassOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId, status])
}

model Notification {
  id            String             @id @default(cuid())
  title         String
  body          String
  category      String             @default("GENERAL")
  audience      String             @default("ALL")
  audienceValue String             @default("")
  pinned        Boolean            @default(false)
  link          String             @default("")
  authorId      String
  createdAt     DateTime           @default(now())
  author        User               @relation("NotificationAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reads         NotificationRead[]

  @@index([createdAt])
}

model NotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("Untitled note")
  body      String   @default("")
  color     String   @default("blue")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model LinkedinPost {
  id        String   @id @default(cuid())
  userId    String
  url       String
  caption   String   @default("")
  postedOn  String
  reactions Int      @default(0)
  comments  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, postedOn])
}

model RewardEntry {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  reason    String
  source    String   @default("MANUAL")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ExtensionRequest {
  id         String    @id @default(cuid())
  userId     String
  /// The locked day the student wants reopened (YYYY-MM-DD).
  date       String
  reason     String
  /// "PENDING" | "APPROVED" | "REJECTED"
  status     String    @default("PENDING")
  remark     String    @default("")
  reviewerId String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  reviewer   User?     @relation("ExtensionReviewer", fields: [reviewerId], references: [id])
  user       User      @relation("ExtensionOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String   @default("")
  meta      String   @default("")
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([entity])
}
