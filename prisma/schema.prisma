generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id                   String             @id
  name                 String
  rollNo               String             @unique
  email                String             @unique
  department           String             @default("")
  year                 String             @default("")
  mobile               String             @default("")
  domain               String             @default("Data not Feeded")
  mentorName           String             @default("")
  gender               String             @default("")
  legend               String             @default("")
  designation          String             @default("")
  linkedin             String             @default("")
  github               String             @default("")
  role                 String             @default("STUDENT")
  systemStatus         String             @default("ACTIVE")
  passwordHash         String
  mustChangePassword   Boolean            @default(true)
  lastLoginAt          DateTime?
  permOverview         Boolean            @default(false)
  permLeaveRequests    Boolean            @default(false)
  permUserManagement   Boolean            @default(false)
  permAttendanceLogs   Boolean            @default(false)
  permWorklogs         Boolean            @default(false)
  permMentorTasks      Boolean            @default(false)
  permActivityApproval Boolean            @default(false)
  permExtensionRequest Boolean            @default(false)
  permNotifications    Boolean            @default(false)
  permLinkedinTracker  Boolean            @default(false)
  permScanStudentQr    Boolean            @default(false)
  permAdminDatabase    Boolean            @default(false)
  permRewardManagement Boolean            @default(false)
  portalNavDisabled    String             @default("")
  rewardPoints         Int                @default(100)
  rewardPointsEnabled  Boolean            @default(true)
  avatarSeed           Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  reviewedPasses       ActivityPass[]     @relation("PassReviewer")
  passes               ActivityPass[]     @relation("PassOwner")
  attendance           Attendance[]
  auditLogs            AuditLog[]
  reviewedExtensions   ExtensionRequest[] @relation("ExtensionReviewer")
  extensions           ExtensionRequest[] @relation("ExtensionOwner")
  leaveRequests        LeaveRequest[]     @relation("LeaveOwner")
  reviewedLeaves       LeaveRequest[]     @relation("LeaveReviewer")
  linkedinPosts        LinkedinPost[]
  notes                Note[]
  notifications        Notification[]     @relation("NotificationAuthor")
  notificationReads    NotificationRead[]
  rewardEntries        RewardEntry[]
  rewardTransactions   RewardTransaction[] @relation("UserRewardTransactions")
  actedRewardTransactions RewardTransaction[] @relation("RewardActor")
  tasksAssigned        Task[]             @relation("TaskAssignee")
  tasksCreated         Task[]             @relation("TaskAuthor")
  worklogs             Worklog[]
  sectionViews         UserSectionView[]
  supportTickets       SupportTicket[]    @relation("TicketOwner")
  assignedTickets      SupportTicket[]    @relation("TicketAssignee")
  ticketMessages       TicketMessage[]    @relation("MessageSender")
  ticketActivities     TicketActivity[]   @relation("ActivityActor")

  @@index([role])
  @@index([year])
  @@index([domain])
  @@index([mentorName])
}

model Attendance {
  id         String   @id @default(cuid())
  userId     String
  rollNo     String   @default("")
  email      String   @default("")
  name       String   @default("")
  department String   @default("")
  year       String   @default("")
  date       String
  hour       Int
  reason     String   @default("")
  status     String   @default("PRESENT")
  source     String   @default("SELF")
  markedBy   String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, hour])
  @@index([date])
  @@index([userId, date])
  @@index([rollNo])
  @@index([email])
}

model Worklog {
  id           String    @id @default(cuid())
  userId       String
  rollNo       String    @default("")
  email        String    @default("")
  name         String    @default("")
  department   String    @default("")
  year         String    @default("")
  date         String
  s1           String    @default("")
  s2           String    @default("")
  s3           String    @default("")
  s4           String    @default("")
  s5           String    @default("")
  taskId       String?
  status       String    @default("SUBMITTED")
  mentorRemark String    @default("")
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  task         Task?     @relation(fields: [taskId], references: [id])
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([status])
  @@index([rollNo])
  @@index([email])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  authorId    String
  assigneeId  String?
  domain      String    @default("")
  year        String    @default("")
  priority    String    @default("MEDIUM")
  status      String    @default("TODO")
  dueDate     String?
  points      Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  author      User      @relation("TaskAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  worklogs    Worklog[]

  @@index([assigneeId, status])
  @@index([status])
}

model ActivityPass {
  id          String    @id @default(cuid())
  userId      String
  date        String
  fromTime    String
  toTime      String
  destination String
  reason      String
  category    String    @default("ACTIVITY")
  status      String    @default("PENDING")
  passCode    String    @unique
  remark      String    @default("")
  reviewerId  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  reviewer    User?     @relation("PassReviewer", fields: [reviewerId], references: [id])
  user        User      @relation("PassOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId, status])
}

model Notification {
  id            String             @id @default(cuid())
  title         String
  body          String
  category      String             @default("GENERAL")
  audience      String             @default("ALL")
  audienceValue String             @default("")
  pinned        Boolean            @default(false)
  link          String             @default("")
  authorId      String
  createdAt     DateTime           @default(now())
  author        User               @relation("NotificationAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reads         NotificationRead[]

  @@index([createdAt])
}

model NotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("Untitled note")
  body      String   @default("")
  color     String   @default("blue")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model LinkedinPost {
  id        String   @id @default(cuid())
  userId    String
  url       String
  caption   String   @default("")
  postedOn  String
  reactions Int      @default(0)
  comments  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, postedOn])
}

model RewardEntry {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  reason    String
  source    String   @default("MANUAL")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ExtensionRequest {
  id         String    @id @default(cuid())
  userId     String
  /// The locked day the student wants reopened (YYYY-MM-DD).
  date       String
  reason     String
  /// "PENDING" | "APPROVED" | "REJECTED"
  status     String    @default("PENDING")
  remark     String    @default("")
  reviewerId String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  reviewer   User?     @relation("ExtensionReviewer", fields: [reviewerId], references: [id])
  user       User      @relation("ExtensionOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String   @default("")
  meta      String   @default("")
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([entity])
}

model LeaveRequest {
  id              String    @id @default(cuid())
  userId          String
  rollNo          String    @default("")
  email           String    @default("")
  name            String    @default("")
  department      String    @default("")
  year            String    @default("")
  leaveType       String
  fromDate        String
  toDate          String
  gateOut         String?
  gateIn          String?
  duration        String    @default("")
  reason          String    @default("")
  remarks         String    @default("")
  venueDetails    String    @default("")
  companyDetails  String    @default("")
  status          String    @default("PENDING")
  reviewerId      String?
  reviewedAt      DateTime?
  reviewerRemark  String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  reviewer        User?     @relation("LeaveReviewer", fields: [reviewerId], references: [id])
  user            User      @relation("LeaveOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId, fromDate])
  @@index([rollNo])
  @@index([email])
}

model RosterOption {
  id        String   @id @default(cuid())
  category  String   // "DEPARTMENT" | "YEAR" | "DOMAIN" | "MENTOR"
  value     String
  label     String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, value])
  @@index([category])
}

model UserSectionView {
  id        String   @id @default(cuid())
  userId    String
  section   String
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, section])
  @@index([userId])
}

model SupportTicket {
  id              String           @id @default(cuid())
  ticketNumber    String           @unique
  userId          String
  name            String
  rollNo          String           @default("")
  email           String           @default("")
  department      String           @default("")
  year            String           @default("")
  category        String
  subcategory     String           @default("")
  subject         String
  description     String           @db.Text
  module          String           @default("GENERAL")
  priority        String           @default("MEDIUM")
  status          String           @default("NEW")
  assignedToId    String?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  reopenedAt      DateTime?
  slaDueAt        DateTime?
  isEscalated     Boolean          @default(false)
  rating          Int?
  feedback        String?          @db.Text
  feedbackAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation("TicketOwner", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo      User?            @relation("TicketAssignee", fields: [assignedToId], references: [id])
  messages        TicketMessage[]
  activities      TicketActivity[]

  @@index([status])
  @@index([userId, status])
  @@index([category])
  @@index([assignedToId])
  @@index([createdAt])
}

model TicketMessage {
  id             String        @id @default(cuid())
  ticketId       String
  senderId       String
  senderName     String
  senderRole     String
  message        String        @db.Text
  isInternalNote Boolean       @default(false)
  isEdited       Boolean       @default(false)
  editedAt       DateTime?
  readAt         DateTime?
  createdAt      DateTime      @default(now())
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender         User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([senderId])
}

model TicketActivity {
  id         String        @id @default(cuid())
  ticketId   String
  actorId    String
  actorName  String
  action     String
  fromStatus String?
  toStatus   String?
  meta       String        @default("")
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor      User          @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model FaqArticle {
  id           String   @id @default(cuid())
  title        String
  category     String
  module       String
  question     String
  answer       String   @db.Text
  helpfulCount Int      @default(0)
  tags         String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([module])
}

model RewardPolicy {
  id          String       @id @default(cuid())
  name        String       @default("Standard Academic Performance Policy")
  baseScore   Int          @default(100)
  maxScore    Int          @default(100)
  minScore    Int          @default(0)
  isActive    Boolean      @default(true)
  periodType  String       @default("SEMESTER") // "MONTHLY" | "SEMESTER" | "ANNUAL" | "CUSTOM"
  startDate   String?      // YYYY-MM-DD
  endDate     String?      // YYYY-MM-DD
  description String       @default("")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  rules       RewardRule[]
}

model RewardRule {
  id                     String              @id @default(cuid())
  policyId               String?
  code                   String              @unique
  name                   String
  category               String              // "LEAVE" | "WORKLOG" | "ATTENDANCE" | "LINKEDIN" | "ON_DUTY" | "TASK" | "OTHER"
  subCategory            String?             // Specific subcategory: e.g. "SICK", "CASUAL", "ON_DUTY", "UNAPPROVED", "MISSED_WORKLOG", "SCHEDULED_LINKEDIN", etc.
  type                   String              // "DEDUCTION" | "REWARD"
  points                 Int                 // Amount to deduct or add (e.g. 5, 2, 10)
  isPercentage           Boolean             @default(true)
  isEnabled              Boolean             @default(true)
  description            String              @default("")
  maxDeductionsPerPeriod Int?
  gracePeriodDays        Int                 @default(0) // Free allowance: e.g. Free Leave Days or Grace Days before penalty applies
  effectiveFrom          String?             // YYYY-MM-DD: From when reward calculation starts
  effectiveTo            String?             // YYYY-MM-DD: Optional end date
  scheduledDates         String              @default("") // Comma-separated YYYY-MM-DD dates (e.g. scheduled LinkedIn dates)
  configJson             String              @default("{}") // Detailed flexible JSON parameters
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  policy                 RewardPolicy?       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  transactions           RewardTransaction[]

  @@index([category])
  @@index([isEnabled])
}

model ScheduledHoliday {
  id          String   @id @default(cuid())
  date        String   @unique // YYYY-MM-DD
  title       String   // Holiday name (e.g. "Diwali Festival", "Semester Break")
  category    String   @default("INSTITUTIONAL") // "GOVERNMENT" | "INSTITUTIONAL" | "FESTIVAL" | "OTHER"
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

model RewardTransaction {
  id            String      @id @default(cuid())
  userId        String
  ruleId        String?
  ruleCode      String
  category      String      // "ATTENDANCE" | "LEAVE" | "ON_DUTY" | "WORKLOG" | "TASK" | "OTHER" | "MANUAL"
  type          String      // "DEDUCTION" | "REWARD" | "ADJUSTMENT"
  points        Int         // signed delta: negative for deduction (e.g. -5), positive for reward (e.g. +10)
  previousScore Int
  newScore      Int
  entityType    String      // "Worklog" | "Attendance" | "LeaveRequest" | "ActivityPass" | "Task" | "LinkedinPost" | "Manual"
  entityId      String      // Entity ID or unique date string (prevents duplicate deductions)
  reason        String
  meta          String      @default("") // JSON string with extra details
  isManual      Boolean     @default(false)
  actorId       String?
  createdAt     DateTime    @default(now())
  user          User        @relation("UserRewardTransactions", fields: [userId], references: [id], onDelete: Cascade)
  rule          RewardRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  actor         User?       @relation("RewardActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([userId, ruleCode, entityId])
  @@index([userId, createdAt])
  @@index([category])
  @@index([ruleCode])
  @@index([createdAt])
}

